PORT=3000
DATABASE_URL="postgresql://username:password@localhost:5432/gymmanager?schema=public"
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="reemplazar_por_un_string_aleatorio_de_al_menos_32_caracteres"
# Solo la usa el seed para crear/resetear el usuario admin. Mínimo 12 caracteres.
ADMIN_PASSWORD="reemplazar-por-una-clave-larga"
NODE_ENV=development
# En producción: URL del frontend en Vercel (puede ser múltiples separadas por coma)
# FRONTEND_URL="https://tu-app.vercel.app"
# En producción detrás del proxy de Render: 1
# TRUST_PROXY_HOPS=1
